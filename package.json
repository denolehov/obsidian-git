{
    "name": "obsidian-git",
    "version": "2.39.0",
    "description": "Integrate Git version control with automatic backup and other advanced features in Obsidian.md",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs dev",
        "build": "node esbuild.config.mjs production",
        "release": "standard-version",
        "lint": "eslint src tests vitest.config.ts",
        "format": "prettier --check src tests vitest.config.ts",
        "tsc": "tsc --noEmit",
        "svelte": "svelte-check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "all": "pnpm run tsc && pnpm run svelte && pnpm run format && pnpm run lint && pnpm run test"
    },
    "keywords": [],
    "author": "Vinzent03",
    "license": "MIT",
    "type": "module",
    "standard-version": {
        "t": ""
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/debug": "^4.1.13",
        "@types/diff3": "^0.0.2",
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "8.65.0",
        "@vitest/coverage-v8": "^4.1.10",
        "esbuild": "^0.28.1",
        "esbuild-svelte": "^0.9.5",
        "eslint": "^9.39.4",
        "eslint-plugin-svelte": "^2.46.1",
        "obsidian": "^1.13.1",
        "prettier": "3.3.2",
        "prettier-plugin-svelte": "^4.1.1",
        "scss": "^0.2.4",
        "standard-version": "^9.5.0",
        "svelte-check": "^4.7.4",
        "svelte-eslint-parser": "^1.8.0",
        "svelte-preprocess": "^6.0.5",
        "tslib": "^2.8.1",
        "typescript": "5.8.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@codemirror/commands": "^6.10.3",
        "@codemirror/merge": "^6.12.2",
        "@codemirror/search": "^6.7.1",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.1",
        "buffer": "^6.0.3",
        "codemirror": "^6.0.2",
        "css-color-converter": "^2.0.0",
        "debug": "^4.4.3",
        "diff": "^9.0.0",
        "diff2html": "^3.4.56",
        "diff3": "^0.0.4",
        "isomorphic-git": "1.40.0",
        "js-sha256": "^0.12.0",
        "simple-git": "^3.36.0",
        "svelte": "^5.56.8"
    },
    "moduleFileExtensions": [
        "js",
        "ts",
        "svelte"
    ]
}
